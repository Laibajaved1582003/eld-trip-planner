# ELD Trip Planner — Environment Variables
# Copy this file to .env and fill in your values.

# Django secret key (generate a new one for production)
SECRET_KEY=your-secret-key-here

# OpenRouteService API key (get one at https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=your-ors-api-key-here

# Debug mode (set to False in production)
DEBUG=True

# Comma-separated list of allowed hosts (no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
